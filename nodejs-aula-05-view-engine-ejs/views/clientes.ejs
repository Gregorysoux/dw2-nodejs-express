<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clientes</title>
</head>
<body>
    <a href="/"><< Voltar </a>
    <br>
    <h1 style="text-align: center;">Clientes</h1>

    <!-- forEach dentro de TABELA -->
     <table border="1">
        <tr>
            <th width="150px">Cliente</th>
            <th>CPF</th>
        </tr>
        <!-- forEach -->
         <% clientes.forEach(cliente => { %>
            <tr>
                <td><%= cliente.nome %></td>
                <td><%= cliente.cpf%></td>
            </tr>
      <% }) %>
     </table>
</body>
</html>