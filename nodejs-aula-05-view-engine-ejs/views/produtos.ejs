<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos</title>
</head>
<body>
    <a href="/"><< Voltar </a>
    <br>
    <h1 style="text-align: center;">Página de produtos!</h1>

    <!--Comentário em EJS-->
    <%# comentário ... #%>
    <!--Chamando a variável para ser exebida na página-->
    <%#= produtos #%>
    <!-- Percorrendo a lista de produtos através do forEach: -->
    <% produtos.forEach(produto => { %>
        <p>Produto: <%= produto.nome %></p>
        <p>Produto: <%= produto.marca %></p>
        <p>Produto: <%= produto.preco %></p>
        <br>
    <% }) %>
</body>
</html>